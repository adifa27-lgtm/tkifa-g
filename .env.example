# Copy to .env.local for local runs. Never commit real values.

# Auth.js — random 32+ bytes (scripts generate it)
AUTH_SECRET=
# Google OAuth client (Web application) — Google Cloud Console → Google Auth Platform → Clients
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Service account that is an Editor on the sheet
GOOGLE_SA_EMAIL=
# The private key from the JSON key file; "\n" escapes are accepted
GOOGLE_SA_PRIVATE_KEY=

SHEET_ID=1KBVkNPjLsH9AolAN3ed9S6eWhaqih2hapsIK8PFcq7o

# Optional: extra emails allowed besides everyone the sheet is shared with (comma separated)
EXTRA_ALLOWED_EMAILS=

# Local only: serve the synthetic fixture instead of the real sheet (refused on Vercel)
# MOCK_SHEET=1
